# rent-api / rent-sweeper configuration.
# Copy to `.env` (which is gitignored) and fill in. Load with Node's built-in flag:
#   node --env-file=.env server.js
#   node --env-file=.env rent-sweeper.js
# (Node 20.6+; the pm2 ecosystem already passes --env-file=.env.)
# NEVER commit the real .env — it holds your key.

# ---------- rent-api ----------
ERGO_NODE_URL=http://127.0.0.1:9053
ALLOW_ORIGIN=https://ergo.runonflux.com
PORT=8480
# LOOKAHEAD_DAYS=14
# OVERDUE_LOOKBACK_BLOCKS=4320
# SCAN_INTERVAL_MS=60000
# CONCURRENCY=12

# ---------- rent-sweeper ----------
RENT_API_URL=http://127.0.0.1:8480

# Provide EXACTLY ONE of these (both fund the tx and receive sweeps):
#   raw dlog secret, 64 hex chars:
SWEEP_PRIVATE_KEY=
#   or a BIP39 mnemonic:
# SWEEP_MNEMONIC=

# SAFE: build + node-validate without broadcasting. Set to 0 only after dry-run checks pass.
DRY_RUN=1

# Where swept funds go (defaults to the wallet address). Make it a public safe address for defensive mode.
# SAFE_ADDRESS=
# BATCH_CAP=20
# MIN_MARGIN=2000000
# KEEP_TOKENS=1
# Also collect the ~fee from FUNDED boxes (recreates them; tokens return to owner).
# Less contested than dust → higher win rate. Validate with DRY_RUN=1 first.
# SWEEP_FUNDED=1
# POLL_MS=1500
# Base/first-bid fee (nanoERG). Mempool replacement needs STRICTLY higher fee/byte, so
# bid just above the 0.001 default other bots use. Higher = win more contested boxes on
# the first try, but you pay it on every box. Escalation (BID_*) climbs from here on losses.
# FEE=1100000
# BID_ESCALATE=1.6
# BID_MAX_FRACTION=0.4
# VERBOSE=1   # per-box logs: rival fee from mempool, our bid, win/lose reason (set 0 to quiet)

# ---------- harvester-analysis (pool self-harvest report, pm2 runs hourly) ----------
# BLOCKS=256                 # how many recent blocks to analyze each run
# EXPLORER_URL=https://api.ergoplatform.com
# IRRATIONAL_FEE=5000000     # nanoERG; fees above this are "only rational if collector is the miner"
