# rent-api / rent-sweeper configuration.
# Copy to `.env` (which is gitignored) and fill in. Load with Node's built-in flag:
#   node --env-file=.env server.js
#   node --env-file=.env rent-sweeper.js
# (Node 20.6+; the pm2 ecosystem already passes --env-file=.env.)
# NEVER commit the real .env — it holds your key.

# ---------- rent-api ----------
ERGO_NODE_URL=http://127.0.0.1:9053
ALLOW_ORIGIN=https://ergo.runonflux.com
PORT=8480
# LOOKAHEAD_DAYS=14
# OVERDUE_LOOKBACK_BLOCKS=4320
# SCAN_INTERVAL_MS=60000
# CONCURRENCY=12

# ---------- rent-sweeper ----------
RENT_API_URL=http://127.0.0.1:8480

# Provide EXACTLY ONE of these (both fund the tx and receive sweeps):
#   raw dlog secret, 64 hex chars:
SWEEP_PRIVATE_KEY=
#   or a BIP39 mnemonic:
# SWEEP_MNEMONIC=

# SAFE: build + node-validate without broadcasting. Set to 0 only after dry-run checks pass.
DRY_RUN=1

# Where swept funds go (defaults to the wallet address). Make it a public safe address for defensive mode.
# SAFE_ADDRESS=
# BATCH_CAP=20
# MIN_MARGIN=2000000
# KEEP_TOKENS=1
